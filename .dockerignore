# Dependencies (installed inside Docker, never copied)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Nuxt/Nitro build outputs (always regenerated by `nuxt build`)
.output/
.nuxt/
.nitro/
.data/
dist/
.cache/

# Tests and testing output (not needed in production images)
coverage/
test-results/
playwright-report/
*.test.*
*.spec.*

# Local development and editor files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log

# Environment variables (only commit template files)
.env
.env*.local
.env.development
.env.test
.env.production.local

# Docker configuration files (not needed inside build context)
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*.yaml
docker-compose*.yml

# Documentation
*.md
docs/

# CI/CD configuration files
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
Jenkinsfile

# Cache directories and temporary data
.tmp/
.temp/
*.tsbuildinfo

# Sensitive or unnecessary configuration files
*.pem
.editorconfig
.prettierrc*
prettier.config.*
.eslintrc*
eslint.config.*
.stylelintrc*
stylelint.config.*
*.iml

# OS-specific junk
.DS_Store
Thumbs.db
Desktop.ini

# AI tool metadata
.cursor/
.copilot/
.gemini/
.claude
AGENTS.md
